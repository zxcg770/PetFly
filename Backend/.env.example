PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/petfly
JWT_SECRET=your_jwt_secret

# Required for the RAG regulation Q&A feature
GEMINI_API_KEY=your_google_gemini_api_key

# Required for Stripe payments
